        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b&gt;Діаграма класів (Class Diagram) — Система «Гуртожиток» (Варіант 3: П.І.П., факультет, кафедра, курс, місце проживання з датами)&lt;/b&gt;&lt;br/&gt;3-рівнева архітектура з шаблоном проєктування Strategy (SAX, DOM, LINQ to XML) та усуненням антишаблону «Магічна кнопка» (Magic Pushbutton) | Виконав: Остапенко Роман, К-24" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#e3f2fd;strokeColor=#2196f3;fontColor=#0d47a1;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="55" as="geometry" />
        </mxCell>

        <!-- 1. MainPage (UI Layer) -->
        <mxCell id="class_mainpage" value="&amp;lt;&amp;lt;boundary / UI&amp;gt;&amp;gt;&#xa;&lt;b&gt;MainPage&lt;/b&gt;&#xa;extends ContentPage&#xa;----------------------------------------------------&#xa;- _dormitoryManager: DormitoryManager&#xa;- _currentXmlPath: string&#xa;- _currentXslPath: string&#xa;----------------------------------------------------&#xa;+ MainPage()&#xa;- OnLoadXmlClicked(sender: object, e: EventArgs): void&#xa;- OnLoadXslClicked(sender: object, e: EventArgs): void&#xa;- OnSearchClicked(sender: object, e: EventArgs): void&#xa;- OnTransformToHtmlClicked(sender: object, e: EventArgs): void&#xa;- OnClearClicked(sender: object, e: EventArgs): void&#xa;- OnHelpClicked(sender: object, e: EventArgs): void&#xa;- OnExitClicked(sender: object, e: EventArgs): void&#xa;- PopulateAttributePickers(attrs: Dictionary&amp;lt;string, List&amp;lt;string&amp;gt;&amp;gt;): void&#xa;- BuildFilterCriteria(): FilterCriteria&#xa;- GetSelectedStrategyType(): SearchStrategyType&#xa;- DisplayResults(students: IReadOnlyList&amp;lt;DormitoryStudent&amp;gt;): void&#xa;- ResetFilterControls(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="430" height="390" as="geometry" />
        </mxCell>

