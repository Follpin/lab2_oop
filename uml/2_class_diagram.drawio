        <!-- 11. SaxXmlSearchStrategy (Concrete Strategy 1) -->
        <mxCell id="class_sax" value="&amp;lt;&amp;lt;strategy / SAX API&amp;gt;&amp;gt;&#xa;&lt;b&gt;SaxXmlSearchStrategy&lt;/b&gt;&#xa;implements IXmlSearchStrategy&#xa;-------------------------------------&#xa;+ StrategyName: string = &quot;SAX (XmlReader)&quot;&#xa;-------------------------------------&#xa;+ Search(xmlPath: string,&#xa;    criteria: FilterCriteria):&#xa;    IReadOnlyList&amp;lt;DormitoryStudent&amp;gt;&#xa;- ReadStudentNode(reader: XmlReader):&#xa;    DormitoryStudent&#xa;- MatchesCriteria(student:&#xa;    DormitoryStudent,&#xa;    criteria: FilterCriteria): bool" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="720" width="280" height="260" as="geometry" />
        </mxCell>

        <!-- 12. DomXmlSearchStrategy (Concrete Strategy 2) -->
        <mxCell id="class_dom" value="&amp;lt;&amp;lt;strategy / DOM API&amp;gt;&amp;gt;&#xa;&lt;b&gt;DomXmlSearchStrategy&lt;/b&gt;&#xa;implements IXmlSearchStrategy&#xa;-------------------------------------&#xa;+ StrategyName: string = &quot;DOM (XmlDocument)&quot;&#xa;-------------------------------------&#xa;+ Search(xmlPath: string,&#xa;    criteria: FilterCriteria):&#xa;    IReadOnlyList&amp;lt;DormitoryStudent&amp;gt;&#xa;- BuildXPathQuery(criteria:&#xa;    FilterCriteria): string&#xa;- MapXmlNodeToStudent(node: XmlNode):&#xa;    DormitoryStudent" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="720" width="280" height="260" as="geometry" />
        </mxCell>

        <!-- 13. LinqXmlSearchStrategy (Concrete Strategy 3) -->
        <mxCell id="class_linq" value="&amp;lt;&amp;lt;strategy / LINQ to XML&amp;gt;&amp;gt;&#xa;&lt;b&gt;LinqXmlSearchStrategy&lt;/b&gt;&#xa;implements IXmlSearchStrategy&#xa;-------------------------------------&#xa;+ StrategyName: string = &quot;LINQ (XDocument)&quot;&#xa;-------------------------------------&#xa;+ Search(xmlPath: string,&#xa;    criteria: FilterCriteria):&#xa;    IReadOnlyList&amp;lt;DormitoryStudent&amp;gt;&#xa;- MatchesXElement(el: XElement,&#xa;    criteria: FilterCriteria): bool&#xa;- MapXElementToStudent(el: XElement):&#xa;    DormitoryStudent" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
