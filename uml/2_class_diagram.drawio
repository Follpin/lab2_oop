        <!-- 9. DormitoryStudent (Domain Entity) -->
        <mxCell id="class_student" value="&amp;lt;&amp;lt;entity / model&amp;gt;&amp;gt;&#xa;&lt;b&gt;DormitoryStudent&lt;/b&gt;&#xa;----------------------------------------------------&#xa;+ Id: string { get; set; }&#xa;+ FullName: string { get; set; }&#xa;+ Faculty: string { get; set; }&#xa;+ Department: string { get; set; }&#xa;+ Course: int { get; set; }&#xa;+ Privilege: string? { get; set; }&#xa;+ Phone: string? { get; set; }&#xa;+ Room: RoomInfo { get; set; }&#xa;+ AdditionalAttributes: Dictionary&amp;lt;string, string&amp;gt; { get; set; }&#xa;----------------------------------------------------&#xa;+ HasAttribute(name: string, value: string): bool&#xa;+ FormatDisplayBlock(): string" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="430" height="290" as="geometry" />
        </mxCell>

        <!-- 10. RoomInfo (Nested Value Object - Level 2 XML Hierarchy) -->
        <mxCell id="class_room" value="&amp;lt;&amp;lt;value object / XML Level 2&amp;gt;&amp;gt;&#xa;&lt;b&gt;RoomInfo&lt;/b&gt;&#xa;----------------------------------------------------&#xa;+ Building: string { get; set; }&#xa;+ Floor: int { get; set; }&#xa;+ RoomNumber: string { get; set; }&#xa;+ CheckInDate: string { get; set; }&#xa;+ CheckOutDate: string? { get; set; }&#xa;+ MonthlyFee: decimal { get; set; }&#xa;----------------------------------------------------&#xa;+ FormatResidencePeriod(): string" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="915" width="360" height="240" as="geometry" />
