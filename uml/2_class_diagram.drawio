  <diagram id="class_diagram_lab2" name="Class Diagram">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
