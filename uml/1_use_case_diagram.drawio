  <diagram id="use_case_diagram_lab2" name="Use Case Diagram">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b&gt;Діаграма прецедентів (Use Case Diagram) — Система «Гуртожиток» (Варіант 3)&lt;/b&gt;&lt;br/&gt;Лабораторна робота №2 з ООП (XML, SAX, DOM, LINQ to XML, XSLT, Шаблон Strategy) | Виконав: Остапенко Роман, К-24" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#e3f2fd;strokeColor=#2196f3;fontColor=#0d47a1;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="sys_boundary" value="Програмна система аналізу та обробки XML-даних «Гуртожиток» (.NET MAUI)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;collapsible=0;recursiveResize=0;expand=0;fontStyle=1;fontSize=14;fillColor=#f8f9fa;strokeColor=#495057;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="980" height="840" as="geometry" />
        </mxCell>

        <!-- Actor: User -->
        <mxCell id="actor_user" value="Користувач&#xa;(Комендант /&#xa;Адміністратор)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="55" height="100" as="geometry" />
        </mxCell>

        <!-- Primary Use Cases (Column 1 inside sys_boundary) -->
        <mxCell id="uc1" value="UC1: Завантажити XML-файл&#xa;бази даних гуртожитку" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="55" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc3" value="UC3: Налаштувати критерії пошуку&#xa;(П.І.П., факультет, кафедра, курс,&#xa;корпус, кімната, пільга)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="145" width="245" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc4" value="UC4: Обрати стратегію&#xa;аналізу XML (Strategy)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="250" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc5" value="UC5: Виконати пошук студентів&#xa;та переглянути результати" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="365" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc6" value="UC6: Трансформувати XML&#xa;у HTML-звіт за XSL-шаблоном" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="475" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc7" value="UC7: Очистити параметри пошуку&#xa;та поле виводу (Clear)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="570" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc8" value="UC8: Переглянути довідку&#xa;«Про програму»" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="660" width="235" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc9" value="UC9: Завершити роботу&#xa;з програмою (Вихід)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="sys_boundary">
          <mxGeometry x="45" y="745" width="235" height="55" as="geometry" />
        </mxCell>

        <!-- Secondary / Included / Extended Use Cases (Column 2 & 3 inside sys_boundary) -->
        <mxCell id="uc2" value="UC2: Автоматично підвантажити&#xa;унікальні значення атрибутів&#xa;у випадаючі списки фільтрів" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="sys_boundary">
          <mxGeometry x="420" y="45" width="245" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc10" value="UC10: Локалізувати та показати&#xa;повідомлення про помилку&#xa;формату XML / XSL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="715" y="105" width="235" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc4_1" value="UC4.1: Потоковий пошук&#xa;через SAX API (XmlReader)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="430" y="180" width="225" height="52" as="geometry" />
        </mxCell>

        <mxCell id="uc4_2" value="UC4.2: Пошук у дереві DOM API&#xa;(XmlDocument + XPath)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="430" y="245" width="225" height="52" as="geometry" />
        </mxCell>

        <mxCell id="uc4_3" value="UC4.3: Пошук через LINQ to XML&#xa;(XDocument + LINQ запити)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="430" y="310" width="225" height="52" as="geometry" />
        </mxCell>

        <mxCell id="uc5_1" value="UC5.1: Делегувати запит через&#xa;XmlSearchContext та відфільтрувати&#xa;вузли &amp;lt;Student&amp;gt; з різними атрибутами" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="420" y="385" width="255" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc6_1" value="UC6.1: Застосувати XslCompiledTransform&#xa;та зберегти згенерований HTML-файл" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="420" y="475" width="255" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc9_1" value="UC9.1: Підтвердити вихід у діалозі&#xa;«Чи дійсно ви хочете завершити&#xa;роботу з програмою?» («Так» / «Ні»)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="sys_boundary">
          <mxGeometry x="420" y="738" width="255" height="68" as="geometry" />
        </mxCell>

        <!-- Explanatory Note inside System Boundary -->
        <mxCell id="note_domain" value="&lt;b&gt;Особливості Варіанта 3 («Гуртожиток»):&lt;/b&gt;&lt;br/&gt;• Вхідний XML має ієрархію &amp;ge; 2 рівнів:&lt;br/&gt;  &lt;code&gt;&amp;lt;DormitoryDatabase&amp;gt;&lt;/code&gt; &amp;rarr; &lt;code&gt;&amp;lt;Student&amp;gt;&lt;/code&gt; &amp;rarr; &lt;code&gt;&amp;lt;Room&amp;gt;&lt;/code&gt;&lt;br/&gt;• Вузли &lt;code&gt;&amp;lt;Student&amp;gt;&lt;/code&gt; мають різну кількість атрибутів&lt;br/&gt;  (обов'язкові: Id, FullName, Faculty, Department, Course;&lt;br/&gt;  додаткові: Privilege, Phone, HasDebt, Scholarship, Notes).&lt;br/&gt;• Під час завантаження XML значення всіх наявних&lt;br/&gt;  атрибутів автоматично підвантажуються у фільтри UI.&lt;br/&gt;• Без антишаблону «Магічна кнопка» (Magic Pushbutton)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="sys_boundary">
          <mxGeometry x="695" y="545" width="265" height="175" as="geometry" />
        </mxCell>

