        <mxCell id="inc_1_2" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=10;dashed=1;rounded=0;strokeWidth=1.5;strokeColor=#2b5b84;" edge="1" parent="sys_boundary" source="uc1" target="uc2">
          <mxGeometry width="160" relative="1" as="geometry" />
        </mxCell>

